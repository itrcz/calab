# Calab web client behind Dokploy/Traefik.
# DOMAIN is substituted by the official nginx entrypoint.
# API, gateway and LiveKit signaling are routed by Traefik directly to their containers.

map $uri $calab_cache_control {
    default     "no-cache";
    ~^/assets/  "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml application/wasm text/plain;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' wss://rtc.${DOMAIN} https://rtc.${DOMAIN}; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; frame-src https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Permissions-Policy "microphone=(self), display-capture=(self), speaker-selection=(self), autoplay=(self)" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $calab_cache_control;

    # Missing asset must be a real 404, never index.html.
    location /assets/ {
        try_files $uri =404;
    }

    # SPA fallback for index.html and client-side routes.
    location / {
        try_files $uri /index.html;
    }
}
