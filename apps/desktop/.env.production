# Build-time defaults for packaged desktop builds (electron-vite loads this for `build`).
# Configuration, not code: override with env at build/run time (CALABA_SERVER_URL wins at runtime).
# Only the first-run default: a saved server origin / stored session (e.g. https://app.calab.ru from
# builds before 2.0.0) is never rewritten — cookies and sessions are per origin (docs/06, «Домены»).
MAIN_VITE_DEFAULT_SERVER_URL=https://app.calab.io
# The pinned update feed: the only host updates are downloaded and installed from automatically
# (review pass 3 B1; https only). Packaged builds only — `electron-vite dev` (development mode)
# does not load this file, so dev builds stay notify-only. The process env wins over this file
# (scripts/build-release.sh passes UPDATE_FEED as MAIN_VITE_UPDATE_FEED).
# releases.calab.ru (baked into builds before 2.0.0) serves the same feed — docs/06, «Домены».
MAIN_VITE_UPDATE_FEED=https://releases.calab.io/
# The pinned GitHub update source (owner/repo; public, no token): the default «Источник обновлений»
# (owner 12.10). Only published releases are visible — release.yml's draft stays unseen until the
# lead publishes it. Both this and the feed above may auto-install (shared/updateFeed.ts).
MAIN_VITE_UPDATE_GITHUB=itrcz/calab
# Explicit connect-src safety net for LiveKit/TURN (P0 bug 1, 0.2.1): the renderer CSP also
# derives *.<parent domain> from the server URL, this list keeps working if that changes.
# Both domain families: a client saved on app.calab.ru (siblings *.calab.ru) or app.calab.io
# (*.calab.io) must reach LiveKit whichever rtc. host the server hands out (LIVEKIT_URL, docs/06).
# The process env CALABA_CSP_CONNECT wins at runtime.
MAIN_VITE_CSP_CONNECT="wss://rtc.calab.io https://rtc.calab.io wss://turn.calab.io https://turn.calab.io wss://rtc.calab.ru https://rtc.calab.ru wss://turn.calab.ru https://turn.calab.ru"
# Plans on the landing page: the «Тариф» tab links here (ADR-0024); unset = no link.
VITE_PRICING_URL=https://calab.io/#pricing
