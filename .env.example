# Local development of the API (`make dev-server` sets the same defaults; values here are
# for running `go run ./cmd/server` in apps/server by hand). Production: infra/docker/.env.example.
DATABASE_URL=postgres://calaba:calaba@localhost:55432/calaba
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=dev-only-jwt-secret-dev-only-jwt-secret
# Token lifetimes: defaults 24h / 8760h (1 year, sliding); revocation is instant regardless.
#ACCESS_TOKEN_TTL=24h
#REFRESH_TOKEN_TTL=8760h
REGISTRATION_MODE=open
# required | optional (ADR-0065): optional = the email code blocks nothing; the address stays unconfirmed
#EMAIL_VERIFICATION=required
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Mail (ADR-0023) → Mailpit from `pnpm infra:dev`; letters at http://localhost:8025
SMTP_HOST=localhost:1025
SMTP_TLS=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Calab <noreply@calab.test>

# Release announce (infra/docker/release.sh, step `announce`; tools/release-announce.py): bot token
# `calab_bot_…` of the bot that posts release notes into «Calab - что нового? ✨». Empty = step skipped.
CALAB_RELEASE_BOT_TOKEN=
