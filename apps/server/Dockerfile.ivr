# The IVR worker of inbound calls (ADR-0117 §2, cmd/ivr). Build context: repo root
# (infra/docker/compose.yml, service ivr).
FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS build
WORKDIR /src
COPY apps/server/go.mod apps/server/go.sum* ./
RUN go mod download
COPY apps/server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ivr ./cmd/ivr

# The ringback tone (425 Hz, 1 s on / 4 s off, the Russian ringing signal) as Ogg/Opus 48 kHz
# mono, made once at build time by the same static ffmpeg the API image carries: the worker
# itself has no encoder and no shell.
FROM mwader/static-ffmpeg:9.0@sha256:b90574a4e2ae62b763c39c384526689e7eb435da6398f4fb3f6c3f1c6a14ce33 AS tones
RUN ["/ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-f", "lavfi", "-i", "sine=frequency=425:duration=1:sample_rate=48000", \
     "-af", "apad=whole_dur=5,volume=0.5", "-ac", "1", "-ar", "48000", "-c:a", "libopus", "-b:a", "24k", "-application", "voip", \
     "-frame_duration", "20", "-page_duration", "20000", "-f", "ogg", "/ringback.ogg"]

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/ivr /ivr
COPY --from=tones /ringback.ogg /assets/ringback.ogg
COPY LICENSE NOTICE COMMERCIAL-LICENSE.md /
ENV IVR_CACHE_DIR=/tmp/ivr-cache IVR_RINGBACK_PATH=/assets/ringback.ogg
ENTRYPOINT ["/ivr"]
