# Caddy behind a TLS-terminating reverse proxy (e.g. a Kubernetes ingress); the production web image runs this.
# Same sites as Caddyfile (sites.caddy), with three differences:
#   - plain HTTP on BEHIND_PROXY_PORT (default 8080); entrypoint.sh writes every site address as
#     http://<host>:<port>, so no certificates are requested here;
#   - the API is reached at API_UPSTREAM (e.g. a Service name) instead of 127.0.0.1:3000;
#   - no rtc./turn. sites: LiveKit and TURN stay on the media host (clients get its URL from the API).
# Env: the same as entrypoint.sh documents, plus BEHIND_PROXY_PORT and API_UPSTREAM.
{
	admin off
	auto_https off
	http_port {$BEHIND_PROXY_PORT:8080}
	persist_config off
	import log.caddy
	servers {
		# The proxy (and anything else in the private network) passes X-Forwarded-For: trust it only
		# from private ranges, otherwise every client would appear as the proxy's address.
		trusted_proxies static private_ranges
		protocols h1
	}
}

import sites.caddy

# Landing site (LANDING_HOST) and release feed host (RELEASES_HOST), generated by entrypoint.sh;
# empty files when unset.
import /tmp/landing.caddy
import /tmp/releases.caddy
