{
  "name": "@calaba/bot-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Calab bots: REST, realtime gateway, commands, webhooks and voice (LiveKit)",
  "type": "module",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
