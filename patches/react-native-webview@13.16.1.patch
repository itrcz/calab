+API_AVAILABLE(ios(14.5))
+@interface RNCWebViewDownloads : NSObject <WKDownloadDelegate>
++ (BOOL)accepts:(WKNavigationAction *)action sourceUri:(NSString *)uri;
+- (BOOL)busy;
+- (void)adopt:(WKDownload *)download from:(UIView *)anchor;
+- (void)cancel;
+@end
+
+@implementation RNCWebViewDownloads {
+  WKDownload *_download;
+  NSURL *_dir;
+  NSURL *_file;
+  __weak UIView *_anchor;
+}
+
+/** The one kind of download this patch takes (see above). */
++ (BOOL)accepts:(WKNavigationAction *)action sourceUri:(NSString *)uri
+{
+  NSURL *origin = RNCDownloadOrigin(uri);
+  NSURL *url = action.request.URL;
+  if (origin == nil || !action.shouldPerformDownload || ![url.scheme.lowercaseString isEqualToString:@"blob"]) return NO;
+  WKFrameInfo *initiator = action.sourceFrame;
+  if (!initiator.isMainFrame || !RNCFrameHasOrigin(initiator, origin)) return NO;
+  NSURL *inner = [NSURL URLWithString:url.resourceSpecifier];
+  return inner != nil && RNCUrlHasOrigin(inner, origin);
+}
+
+/** A download is in flight here or a sheet is open anywhere: the next one is refused. */
+- (BOOL)busy
+{
+  return _download != nil || RNCDownloadSheetOpen();
+}
+
+- (void)adopt:(WKDownload *)download from:(UIView *)anchor
+{
+  if ([self busy]) {
+    [download cancel:nil];
+    return;
+  }
+  static dispatch_once_t swept;
+  dispatch_once(&swept, ^{
+    [NSFileManager.defaultManager removeItemAtURL:RNCDownloadsRoot() error:nil];
+  });
+  _download = download;
+  _anchor = anchor;
+  download.delegate = self;
+}
+
+/** The WebView goes away: stop the download in flight. An open sheet keeps its file until it closes. */
+- (void)cancel
+{
+  WKDownload *download = _download;
+  [self drop];
+  [download cancel:nil];
+}
+
+- (void)drop
+{
+  if (_dir != nil) [NSFileManager.defaultManager removeItemAtURL:_dir error:nil];
+  _download = nil;
+  _dir = nil;
+  _file = nil;
+}
+
+- (void)download:(WKDownload *)download decideDestinationUsingResponse:(NSURLResponse *)response suggestedFilename:(NSString *)suggestedFilename completionHandler:(void (^)(NSURL *))completionHandler
+{
+  if (download != _download) {
+    completionHandler(nil);
+    return;
+  }
+  NSURL *dir = [RNCDownloadsRoot() URLByAppendingPathComponent:NSUUID.UUID.UUIDString isDirectory:YES];
+  if (![NSFileManager.defaultManager createDirectoryAtURL:dir withIntermediateDirectories:YES attributes:nil error:nil]) {
+    [self drop];
+    completionHandler(nil);
+    return;
+  }
+  _dir = dir;
+  _file = [dir URLByAppendingPathComponent:RNCSafeFileName(suggestedFilename) isDirectory:NO];
+  completionHandler(_file);
+}
+
+- (void)download:(WKDownload *)download didFailWithError:(NSError *)error resumeData:(NSData *)resumeData
+{
+  if (download != _download) return;
+  RCTLogWarn(@"WebView download failed: %@ %ld", error.domain, (long)error.code);
+  [self drop];
+}
+
+- (void)downloadDidFinish:(WKDownload *)download
+{
+  if (download != _download) return;
+  NSURL *dir = _dir;
+  NSURL *file = _file;
+  UIView *anchor = _anchor;
+  _download = nil;
+  _dir = nil;
+  _file = nil;
+  UIViewController *host = anchor.window.rootViewController;
+  while (host.presentedViewController != nil) host = host.presentedViewController;
+  if (file == nil || host == nil || host.isBeingDismissed || RNCDownloadSheetOpen()) {
+    [NSFileManager.defaultManager removeItemAtURL:dir error:nil];
+    return;
+  }
+  UIActivityViewController *sheet = [[UIActivityViewController alloc] initWithActivityItems:@[file] applicationActivities:nil];
+  sheet.popoverPresentationController.sourceView = anchor;
+  sheet.popoverPresentationController.sourceRect = CGRectMake(CGRectGetMidX(anchor.bounds), CGRectGetMidY(anchor.bounds), 0, 0);
+  // Called once the sheet closes: after the chosen activity has taken the file, or on dismissal.
+  sheet.completionWithItemsHandler = ^(UIActivityType type, BOOL completed, NSArray *items, NSError *error) {
+    [NSFileManager.defaultManager removeItemAtURL:dir error:nil];
+  };
+  RNCDownloadSheet = sheet;
+  [host presentViewController:sheet animated:YES completion:nil];
+}
+
+@end
+#endif // TARGET_OS_IOS

