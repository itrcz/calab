# Dokploy -> Environment tab. Never commit real values.
# Passwords: hex/base64 without special characters (they end up in URLs): `openssl rand -hex 24`.

# Main domain. The app is served on it, LiveKit on rtc.<DOMAIN>, TURN on turn.<DOMAIN>
DOMAIN=calab.example.com

# Extra Traefik middlewares for the HTTPS routers, comma-separated (e.g. a CrowdSec bouncer).
# Empty = none. Names must exist in your Traefik, otherwise the routers return 404.
TRAEFIK_MIDDLEWARES=

# TURN/UDP port. Dokploy's Traefik may hold 443/udp (HTTP/3), so the default is 3478.
# TURN/TLS for UDP-blocked networks goes over 443/tcp through Traefik (turn.<DOMAIN>).
TURN_UDP_PORT=3478

LIVEKIT_API_KEY=                     # "API" + `openssl rand -hex 6`
LIVEKIT_API_SECRET=                  # `openssl rand -hex 32` (>= 32 bytes)
JWT_SECRET=                          # `openssl rand -hex 48`
POSTGRES_PASSWORD=
REDIS_PASSWORD=

REGISTRATION_MODE=invite             # open | invite
SUPERADMIN_EMAILS=

# Mail (empty SMTP_HOST = mail disabled)
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

MAX_FILE_SIZE_MB=50
STORAGE_MAX_TOTAL_BYTES=53687091200

# GET /api/version (the build has no .git, so pass them in)
CALABA_VERSION=
CALABA_COMMIT=

# Optional
# ACCESS_TOKEN_TTL=24h
# REFRESH_TOKEN_TTL=8760h
# REDIS_KEY_PREFIX=
# PLAN_FREE_LIMITS=
# PLAN_TEAM_LIMITS=
# PLAN_CONTACT_URL=
# PLAN_CONTACT_EMAIL=
# BOT_RATE_PER_SEC=30
# BOT_MESSAGES_PER_MIN=20

# Identity 2.0 (docs/06-deployment.md, "Identity 2.0"). Leave ALL empty to keep it off;
# set the whole group at once, a partial configuration stops the API at startup.
# IDENTITY_PUBLIC_ORIGIN=
# IDENTITY_ENCRYPTION_KEYS=
# IDENTITY_ENCRYPTION_ACTIVE_KID=
# OAUTH_SIGNING_KEYS=
# OAUTH_SIGNING_ACTIVE_KID=
# IDENTITY_ENDPOINTS=
# IDENTITY_DIRECTORY_HOSTS=
# IDENTITY_EDITION=
# IDENTITY_ENTERPRISE_WORKSPACE_IDS=
