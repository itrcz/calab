# Phone host (ADR-0067). Copy to `.env` (git-ignored); Expo CLI loads it for app.config.ts and the bundle.
# The web client origin, https only, no path. The app shows exactly this origin.
EXPO_PUBLIC_CALAB_URL=https://calab.example.com
# Optional (ADR-0142): space-separated hostnames whose https /t/, /join/ and /r/ links open the app
# (iOS associated domains, Android verified app links). Default: the host of EXPO_PUBLIC_CALAB_URL.
# Each host must serve the matching apple-app-site-association / assetlinks.json.
# EXPO_PUBLIC_CALAB_LINK_HOSTS=calab.example.com alias.example.com
# Native identifiers (required by `expo prebuild` / `expo run:*`).
CALAB_IOS_BUNDLE_ID=com.example.calab
CALAB_ANDROID_APPLICATION_ID=com.example.calab
# EAS project link (optional; only for `eas` commands).
CALAB_EXPO_OWNER=
CALAB_EAS_PROJECT_ID=

# Optional APNs build capability. Leave absent for the existing local profile without APS.
# Requires matching app/team/profile and server transport configuration; no EAS Push service.
# CALAB_IOS_PUSH_ENVIRONMENT=development
# Experimental iOS incoming calls (PushKit + CallKit). Default is off; requires APS above.
# Cold locked answer/audio remains a real-device gate, not a source-test guarantee.
# CALAB_IOS_INCOMING_CALLS=1

# Local defaults are 0.1.0 / 1. Before a store upload, verify live distribution history.
# CALAB_APP_VERSION=0.1.0
# CALAB_IOS_BUILD_NUMBER=21
# Optional: Android's versionCode (integer, 1 to 2100000000). Defaults to CALAB_IOS_BUILD_NUMBER,
# so one number drives both stores; set it only when Android needs to move ahead on its own
# (Play rejects a re-upload of the same versionCode).
# CALAB_ANDROID_VERSION_CODE=21
# Optional native audio for accepted incoming Calab calls; requires both flags above.
# CALAB_IOS_NATIVE_CALL_AUDIO=1
