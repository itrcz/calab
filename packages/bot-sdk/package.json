    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "~8.70.1",
    "vitest": "^3.0.0"
  }
