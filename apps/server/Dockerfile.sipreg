# The SIP registration agent of inbound calls (ADR-0121, cmd/sipreg). Build context: repo root
# (infra/docker/compose.yml, service sipreg). No shell, no files: the accounts live in memory.
FROM golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS build
WORKDIR /src
COPY apps/server/go.mod apps/server/go.sum* ./
RUN go mod download
COPY apps/server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sipreg ./cmd/sipreg

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/sipreg /sipreg
COPY LICENSE NOTICE COMMERCIAL-LICENSE.md /
ENTRYPOINT ["/sipreg"]
