# Caddy + caddy-l4 as a listener wrapper. One IP, TCP 443:
#   SNI turn.<any domain> -> layer4: terminate TLS here, proxy plain TURN to LiveKit 127.0.0.1:5349
#                        (LiveKit runs with turn.external_tls: true)
#   anything else     -> falls through to the regular HTTPS server (app, landing, rtc.*)
# HTTP/3 is disabled: UDP 443 belongs to LiveKit TURN/UDP.
# Host lists come from entrypoint.sh (APP_HOST/LANDING_HOST/DOMAIN/DOMAIN_ALT/DOMAIN_LEGACY/DOMAIN_ALIASES and the
# *_HOST_ALIASES → APP_HOSTS,
# RTC_HOSTS, TURN_HOSTS, RTC_ORIGINS, RELEASES_ORIGIN, /tmp/landing.caddy, /tmp/download.caddy, /tmp/releases.caddy) — see docs/10-branding.md.
{
	admin off
	import log.caddy
	servers :443 {
		listener_wrappers {
			layer4 {
				@turn tls sni {$TURN_HOSTS}
				route @turn {
					tls
					proxy 127.0.0.1:5349
				}
			}
			# must come after layer4 so SNI routing sees the raw ClientHello
			tls
		}
		protocols h1 h2
	}
}

import sites.caddy

{$RTC_HOSTS} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# LiveKit signal (WSS)
	reverse_proxy 127.0.0.1:7880
}

{$TURN_HOSTS} {
	# Exists only so Caddy obtains and renews the turn.* certificates used by the layer4 route above.
	respond 404
}

# Landing site (LANDING_HOST) and release feed host (RELEASES_HOST), generated by entrypoint.sh;
# empty files when unset.
import /tmp/landing.caddy
import /tmp/releases.caddy
