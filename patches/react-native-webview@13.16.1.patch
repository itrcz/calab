+package com.reactnativecommunity.webview;
+
+import java.util.regex.Pattern;
+
+/**
+ * Calab patch (ADR-0067): the app origin check of the native main-frame guard. Plain JVM code (no
+ * android.*) so a host JVM test can run it. Mirrors `isAppUrl` in apps/mobile/src/navigation.ts:
+ * https, the exact host and port of the origin, no credentials. Only the scheme and the authority
+ * are read, leniently: path, query and fragment may hold anything Chromium leaves unencoded
+ * (`|`, `^`, `{}`, backtick), which a strict parser such as java.net.URI rejects. Components are
+ * compared, never string prefixes; an authority that does not split cleanly is not the app.
+ */
+public final class CalabOriginGuard {
+    private CalabOriginGuard() {}
+
+    private static final Pattern SCHEME = Pattern.compile("[A-Za-z][A-Za-z0-9+.-]*");
+    private static final Pattern PORT = Pattern.compile("[0-9]{1,5}");
+    /** A host as `parseWebOrigin` (apps/mobile/src/config.js) leaves it: lowercase, LDH labels. */
+    private static final Pattern ORIGIN_HOST = Pattern.compile("[a-z0-9]([a-z0-9.-]*[a-z0-9])?");
+
+    /** The configured app origin, parsed once. */
+    public static final class Origin {
+        final String host;
+        final int port;
+
+        Origin(String host, int port) {
+            this.host = host;
+            this.port = port;
+        }
+
+        @Override
+        public String toString() {
+            return "https://" + host + (port == 443 ? "" : ":" + port);
+        }
+    }
+
+    /** Scheme and authority of `scheme://authority...`; port -1 when absent. */
+    private static final class Parts {
+        String scheme;
+        boolean credentials;
+        String host;
+        int port = -1;
+    }
+
+    private static Parts parts(String raw) {
+        if (raw == null) return null;
+        int colon = raw.indexOf(':');
+        if (colon <= 0 || !SCHEME.matcher(raw.substring(0, colon)).matches() || !raw.startsWith("//", colon + 1)) return null;
+        int start = colon + 3;
+        int end = raw.length();
+        for (int i = start; i < raw.length(); i++) {
+            char c = raw.charAt(i);
+            if (c == '/' || c == '?' || c == '#') {
+                end = i;
+                break;
+            }
+        }
+        String authority = raw.substring(start, end);
+        Parts p = new Parts();
+        p.scheme = raw.substring(0, colon);
+        int at = authority.lastIndexOf('@');
+        p.credentials = at >= 0;
+        String hostPort = authority.substring(at + 1);
+        int portColon = hostPort.lastIndexOf(':');
+        p.host = portColon >= 0 ? hostPort.substring(0, portColon) : hostPort;
+        if (p.host.isEmpty()) return null;
+        if (portColon >= 0 && portColon < hostPort.length() - 1) {
+            String port = hostPort.substring(portColon + 1);
+            if (!PORT.matcher(port).matches()) return null;
+            p.port = Integer.parseInt(port);
+            if (p.port > 65535) return null;
+        }
+        return p;
+    }
+
+    /**
+     * The configured origin in the form `parseWebOrigin` writes it — `https://host[:port]`,
+     * lowercase host, no default port, nothing else — or null.
+     */
+    public static Origin parseOrigin(String raw) {
+        Parts p = parts(raw);
+        if (p == null || !"https".equals(p.scheme) || p.credentials || !ORIGIN_HOST.matcher(p.host).matches() || p.port == 443) return null;
+        Origin origin = new Origin(p.host, p.port == -1 ? 443 : p.port);
+        return origin.toString().equals(raw) ? origin : null;
+    }
+
+    /** `url` is a document of the app: https, exactly the host and port of `origin`, no credentials. */
+    public static boolean isAppUrl(String url, Origin origin) {
+        if (origin == null) return false;
+        Parts p = parts(url);
+        return p != null
+            && "https".equalsIgnoreCase(p.scheme)
+            && !p.credentials
+            && p.host.equalsIgnoreCase(origin.host)
+            && (p.port == -1 ? 443 : p.port) == origin.port;
+    }
+}
