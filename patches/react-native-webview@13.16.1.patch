+#pragma mark - Optional Calab status capability (ADR-0069)
+
+- (void)calabRevokeAuthority
+{
+  _calabBridgeDocument = nil;
+  _calabBridgeEpoch++;
+  // Native consumers revoke synchronously, before RN can receive more page messages.
+  [NSNotificationCenter.defaultCenter postNotificationName:@"CalabHostDocumentInvalidated" object:self];
+}
+
+- (void)calabForwardMessage:(WKScriptMessage *)message
+{
+  if (!_onMessage) return;
+  NSMutableDictionary<NSString *, id> *event = [self baseEvent];
+  event[@"data"] = message.body;
+  _onMessage(event);
+}
+
+- (void)calabReceiveMessage:(WKScriptMessage *)message
+{
+  NSURL *origin = RNCDownloadOrigin([RCTConvert NSString:_source[@"uri"]]);
+  WKFrameInfo *frame = message.frameInfo;
+  // Native identity is mandatory: the top page's URL or main-frame injection alone proves nothing.
+  if (!_messagingEnabled || !_onMessage || message.webView != _webView || origin == nil ||
+      !frame.isMainFrame || !RNCFrameHasOrigin(frame, origin) || !RNCUrlHasOrigin(frame.request.URL, origin) ||
+      !RNCUrlHasOrigin(_webView.URL, origin) || ![message.body isKindOfClass:NSString.class]) return;
+  NSString *raw = message.body;
+  if ([raw lengthOfBytesUsingEncoding:NSUTF8StringEncoding] > 8192) return;
+  NSData *data = [raw dataUsingEncoding:NSUTF8StringEncoding];
+  id parsed = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+  if (![parsed isKindOfClass:NSDictionary.class]) return;
+  NSDictionary *body = parsed;
+  if (![body[@"v"] isKindOfClass:NSNumber.class] || [body[@"v"] integerValue] != 1 ||
+      ![body[@"document"] isKindOfClass:NSString.class] || ![body[@"host"] isKindOfClass:NSNumber.class]) return;
+  NSString *document = body[@"document"];
+  if (document.length != 36 || [[NSUUID alloc] initWithUUIDString:document] == nil) return;
+  NSString *type = body[@"type"];
+  if (![type isKindOfClass:NSString.class]) return;
+  if ([type isEqualToString:@"hello"]) {
+    if ([_calabBridgeDocument isEqualToString:document]) { [self calabForwardMessage:message]; return; }
+    // An old document can queue a hello during navigation. Challenge the CURRENT top document;
+    // completion must still belong to this WebView/navigation epoch. No origin/nonce from JS is trusted alone.
+    NSString *ids = [[NSString alloc] initWithData:[NSJSONSerialization dataWithJSONObject:@[document, body[@"host"]] options:0 error:nil] encoding:NSUTF8StringEncoding];
+    NSString *challenge = [NSString stringWithFormat:@"(() => { const h=window.CalabHostActivity; const ids=%@; return !!h && h.version===1 && h.document===ids[0] && h.host===ids[1]; })()", ids];
+    NSUInteger epoch = _calabBridgeEpoch;
+    __weak RNCWebViewImpl *weakSelf = self;
+    __weak WKWebView *expectedView = _webView;
+    [_webView evaluateJavaScript:challenge completionHandler:^(id result, NSError *error) {
+      RNCWebViewImpl *host = weakSelf;
+      if (host == nil || expectedView == nil || host->_webView != expectedView || host->_calabBridgeEpoch != epoch ||
+          error != nil || ![result isKindOfClass:NSNumber.class] || ![result boolValue]) return;
+      [host calabRevokeAuthority];
+      host->_calabBridgeDocument = document;
+      [NSNotificationCenter.defaultCenter postNotificationName:@"CalabHostDocumentGranted" object:host userInfo:@{@"document":document}];
+      [host calabForwardMessage:message];
+    }];
+    return;
+  }
+  if (![_calabBridgeDocument isEqualToString:document]) return;
+  if ([type isEqualToString:@"revoke"]) { if ([body[@"reason"] isEqual:@"logout"]) [NSNotificationCenter.defaultCenter postNotificationName:@"CalabHostSessionCleared" object:self]; [self calabRevokeAuthority]; [self calabForwardMessage:message]; }
+  else if ([type isEqualToString:@"activity"] || [type isEqualToString:@"notifications"] || [type isEqualToString:@"calls"] || [type isEqualToString:@"permissions"]) [self calabForwardMessage:message];
+}
+#endif
