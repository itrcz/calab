+#pragma mark - Page downloads (Calab patch, ADR-0068)
+
+/**
+ * WebKit reports an `<a download>` click as a navigation; the library never answers one with a
+ * download, so it reached `onShouldStartLoadWithRequest` and was dropped. One case becomes a native
+ * download here: a blob: URL of the origin the WebView was opened with (`source.uri`), started by
+ * the main frame of that origin. Both facts come from WebKit (WKFrameInfo.securityOrigin, the
+ * request URL), not from anything the page reports; iframes, http(s) URLs and other sources keep
+ * the old path. WebKit streams the blob into a fresh directory in the app's tmp; once it is complete
+ * the system share sheet gets the file (Save to Files, Save Image, AirDrop, other apps). The
+ * directory is deleted when the sheet closes, on failure or cancel, and a killed process's
+ * leftovers at the first download of the next run.
+ */
+
+static NSString *const RNCDownloadsDirName = @"rnc-webview-downloads";
+/** UTF-8 bytes of a file name (APFS allows 255). */
+static const NSUInteger RNCDownloadNameMaxBytes = 200;
+static const NSUInteger RNCDownloadExtMaxLength = 16;
+
+static NSURL *RNCDownloadsRoot(void)
+{
+  return [[NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES] URLByAppendingPathComponent:RNCDownloadsDirName isDirectory:YES];
+}
+
+/** Messaging nil returns 0 == NSOrderedSame: both hosts must be present. */
+static BOOL RNCSameHost(NSString *a, NSString *b)
+{
+  return a.length > 0 && b.length > 0 && [a caseInsensitiveCompare:b] == NSOrderedSame;
+}
+
+/** The https default filled in: NSURL leaves the port nil, WKSecurityOrigin reports 0. */
+static NSInteger RNCHttpsPort(NSInteger port)
+{
+  return port > 0 ? port : 443;
+}
+
+/** `source.uri` as an origin: https with a host and no credentials; nil for anything else (html source, http). */
+static NSURL *RNCDownloadOrigin(NSString *uri)
+{
+  NSURL *url = uri.length > 0 ? [NSURL URLWithString:uri] : nil;
+  BOOL https = [url.scheme.lowercaseString isEqualToString:@"https"];
+  return https && url.host.length > 0 && url.user == nil && url.password == nil ? url : nil;
+}
+
+static BOOL RNCUrlHasOrigin(NSURL *url, NSURL *origin)
+{
+  return [url.scheme.lowercaseString isEqualToString:@"https"] && url.user == nil && url.password == nil &&
+    RNCSameHost(url.host, origin.host) && RNCHttpsPort(url.port.integerValue) == RNCHttpsPort(origin.port.integerValue);
+}
+
+static BOOL RNCFrameHasOrigin(WKFrameInfo *frame, NSURL *origin)
+{
+  WKSecurityOrigin *o = frame.securityOrigin;
+  return [o.protocol.lowercaseString isEqualToString:@"https"] && RNCSameHost(o.host, origin.host) &&
+    RNCHttpsPort(o.port) == RNCHttpsPort(origin.port.integerValue);
+}
+
+/**
+ * A leaf name from the page's `download` attribute: no path separators, control or format
+ * characters (bidi overrides are format characters), no leading or trailing dots and spaces,
+ * bounded with the extension kept, never empty. It only names a file inside a fresh directory.
+ */
+static NSString *RNCSafeFileName(NSString *raw)
+{
+  NSMutableCharacterSet *bad = [NSMutableCharacterSet controlCharacterSet];
+  [bad formUnionWithCharacterSet:[NSCharacterSet illegalCharacterSet]];
+  [bad formUnionWithCharacterSet:[NSCharacterSet newlineCharacterSet]];
+  [bad addCharactersInString:@"/\\:"];
+  NSString *name = raw.length > 1024 ? [raw substringToIndex:[raw rangeOfComposedCharacterSequenceAtIndex:1024].location] : (raw ?: @"");
+  name = [[name componentsSeparatedByCharactersInSet:bad] componentsJoinedByString:@"_"];
+  NSMutableCharacterSet *edge = [NSMutableCharacterSet whitespaceCharacterSet];
+  [edge addCharactersInString:@"."];
+  name = [name stringByTrimmingCharactersInSet:edge];
+  NSString *ext = name.pathExtension.length <= RNCDownloadExtMaxLength ? name.pathExtension : @"";
+  NSString *base = ext.length > 0 ? name.stringByDeletingPathExtension : name;
+  NSString *(^join)(NSString *) = ^(NSString *b) {
+    return ext.length > 0 ? [NSString stringWithFormat:@"%@.%@", b, ext] : b;
+  };
+  while (base.length > 0 && [join(base) lengthOfBytesUsingEncoding:NSUTF8StringEncoding] > RNCDownloadNameMaxBytes) {
+    base = [base substringToIndex:[base rangeOfComposedCharacterSequenceAtIndex:base.length - 1].location];
+  }
+  base = [base stringByTrimmingCharactersInSet:edge];
+  return join(base.length > 0 ? base : @"file");
+}
+
+/** One share sheet in the app at a time. Weak: the presentation keeps it alive. */
+static __weak UIViewController *RNCDownloadSheet;
+
+/** Still on screen; a dismissed sheet the system keeps alive a little longer does not count. */
+static BOOL RNCDownloadSheetOpen(void)
+{
+  return RNCDownloadSheet.presentingViewController != nil;
+}
