# Скопировать в infra/docker/.env на хосте. Не коммитить.
# Домены (docs/10-branding.md). DOMAIN даёт rtc.<DOMAIN> и turn.<DOMAIN> (TURN анонсируется по нему).
# На стенде: DOMAIN=calab.io, APP_HOST=app.calab.io, LANDING_HOST=calab.io (+ алиасы calab.ru ниже, docs/06 «Домены»)
DOMAIN=calab.example.com
# Приложение (веб-клиент, API, gateway, /download/); пусто = DOMAIN
APP_HOST=
# Лендинг (статика apps/landing/out); пусто = без лендинга
LANDING_HOST=
# Дополнительный хост приложения (алиас, опционально; только приложение — rtc./turn. клиент получает от API по DOMAIN). На стенде: meet.gptunnel.ru
DOMAIN_ALT=
# Ещё один дополнительный хост приложения (опционально, напр. на время переезда). На стенде: app.calab.ru
DOMAIN_LEGACY=
# Доп. зоны через пробел: rtc.<зона> и turn.<зона> тоже обслуживаются (тот же LiveKit). На стенде: calab.ru
DOMAIN_ALIASES=
# rtc-хост, который API отдаёт клиентам (LIVEKIT_URL); пусто = rtc.<DOMAIN>. После переезда домена оставить
# старый, пока есть установленные десктоп-сборки старше переезда (их CSP знает только старое семейство).
# На стенде: rtc.calab.ru
RTC_PUBLIC_HOST=
# Доп. хосты лендинга через пробел → 301 на LANDING_HOST. На стенде: calab.ru
LANDING_HOST_ALIASES=
# Фид релизов десктопа. Не задан → releases.<DOMAIN>; пусто → нет (релизы на /download/ локально).
# С ним /download/* на приложении и лендинге → 302 на этот хост. На стенде: releases.calab.io
RELEASES_HOST=
# Доп. хосты фида через пробел: тот же фид без редиректа (адрес фида зашит в установленные сборки). На стенде: releases.calab.ru
RELEASES_HOST_ALIASES=
# Публичный базовый URL бакета релизов (куда публикует GitHub Actions), напр. https://storage.yandexcloud.net/<bucket>;
# пусто → releases-хост раздаёт /srv/releases
S3_PUBLIC_URL=
LIVEKIT_API_KEY=                     # "API" + `openssl rand -hex 6`, например APIa1b2c3d4e5f6
LIVEKIT_API_SECRET=                  # `openssl rand -base64 48` (должен быть ≥ 32 байт)
JWT_SECRET=                          # `openssl rand -base64 48`
# Workspace identity / OAuth provider (ADR-0054, docs/plans/release-2.0-identity.md §8/§13).
# Leave ALL seven dependency settings empty for legacy startup (identity routes return 503).
# Any partial/invalid dependency configuration fails startup. No JWT_SECRET reuse/fallback.
# See docs/plans/identity-v2-deployment-check.md for formats, rollout and rotation prerequisites.
IDENTITY_PUBLIC_ORIGIN=              # exact HTTPS origin, no trailing slash/path/query/fragment
IDENTITY_ENCRYPTION_KEYS=            # JSON kid -> standard base64 of exactly 32 independent AES key bytes
IDENTITY_ENCRYPTION_ACTIVE_KID=
OAUTH_SIGNING_KEYS=                  # JSON kid -> one RSA PEM per value (JSON-escaped newlines)
OAUTH_SIGNING_ACTIVE_KID=            # must select a private RSA key; RSA 2048..8192 bits
# workspace_ids: exact workspace UUIDs an entry applies to; required for IDENTITY_DIRECTORY_HOSTS and
# for IDENTITY_ENDPOINTS with private_cidrs unless IDENTITY_EDITION=enterprise (on-prem), e.g.
# IDENTITY_DIRECTORY_HOSTS=[{"host":"dc1.corp.example","networks":["10.20.0.0/16"],"workspace_ids":["<uuid>"]}]
IDENTITY_ENDPOINTS=                  # JSON array of exact URL + approved_cidrs/private_cidrs/ca_pem/workspace_ids
IDENTITY_DIRECTORY_HOSTS=            # JSON array of exact lowercase host + networks/ca_pem/workspace_ids (LDAPS)
IDENTITY_EDITION=cloud               # cloud | enterprise; entitlement does not configure dependencies
IDENTITY_ENTERPRISE_WORKSPACE_IDS=   # enterprise only: comma-separated exact nonzero workspace UUIDs
# PLACEHOLDERS ONLY: replace offline, keep resulting keys out of git/logs/shell history.
# IDENTITY_ENCRYPTION_KEYS='{"enc-current":"<base64-of-32-independent-random-bytes>"}'
# IDENTITY_ENCRYPTION_ACTIVE_KID=enc-current
# OAUTH_SIGNING_KEYS='{"sig-current":"-----BEGIN PRIVATE KEY-----\n<PKCS8-RSA-base64>\n-----END PRIVATE KEY-----\n","sig-next":"-----BEGIN PUBLIC KEY-----\n<SPKI-RSA-base64>\n-----END PUBLIC KEY-----\n"}'
# OAUTH_SIGNING_ACTIVE_KID=sig-current
# Prepublish next public key before private-key activation; retain old public keys for token
# lifetime + 60s skew + 60s JWKS cache (release-2.0-identity §8; deployment-check rotation notes).
# Сроки токенов (по умолчанию access 24h, refresh 8760h = 1 год, скользящий). Отзыв сессии
# (выход, «выйти везде», смена пароля) действует мгновенно при любых сроках; ужесточить можно так:
#ACCESS_TOKEN_TTL=15m
#REFRESH_TOKEN_TTL=720h
POSTGRES_PASSWORD=
REDIS_PASSWORD=                      # `openssl rand -hex 24` (hex: goes into REDIS_URL)
# Пространство имён ключей и каналов API в Valkey (docs/06 «Общий Valkey»), напр. calab: — когда Valkey
# общий с другими приложениями и у API свой ACL-пользователь. Пусто = прежние имена ключей.
REDIS_KEY_PREFIX=
REGISTRATION_MODE=invite             # open | invite
# Код из письма (ADR-0065): required — без подтверждения почты нельзя создавать пространства,
# приглашать и начинать личные переписки; optional — ничего не блокирует, адрес остаётся
# неподтверждённым (поиск по почте, приглашения по почте, OAuth и суперадмин ему не доверяют).
# Открытая регистрация без кода: REGISTRATION_MODE=open + EMAIL_VERIFICATION=optional.
EMAIL_VERIFICATION=required          # required | optional
# Почта (ADR-0023): коды подтверждения, сброс пароля, приглашения. SMTP_HOST пусто = без почты.
# Стенд: mail.unne.ai, порт 465, implicit TLS, логин = адрес отправителя. SPF/DKIM/DMARC — docs/06.
SMTP_HOST=
SMTP_PORT=465                        # пусто = по SMTP_TLS: 465 tls / 587 starttls / 25 none
SMTP_TLS=tls                         # tls | starttls | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                           # "Calab <noreply@calab.io>"
MAX_FILE_SIZE_MB=50
# Лимит всех загрузок на диске (байты), по умолчанию 50 GiB
STORAGE_MAX_TOTAL_BYTES=53687091200
# Хранилище файлов (ADR-0011). compose.yml задаёт API STORAGE_DRIVER=fs (volume files_data).
# Драйвер s3 — для нескольких реплик API (Kubernetes): там эти переменные идут в окружение API,
# см. docs/06 «Файлы в S3». Не путать с S3_* бакета релизов выше.
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=https://storage.yandexcloud.net
# STORAGE_S3_REGION=ru-central1
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_KEY_PREFIX=             # необязательно: все объекты под <префикс>/
# STORAGE_S3_FORCE_PATH_STYLE=true
# Тарифы (ADR-0024). Лимиты — JSON поверх встроенных (free: 5 в комнате, 50 участников, звук 16,
# 720p/15, 1 стрим, 5120 МБ, 1 бот, 1 стикерпак; team: 50 в комнате, 20 ботов, 1 ТБ, остальное без
# лимита; enterprise — без лимитов, не настраивается); 0 / "" = без лимита. Пусто = встроенные.
PLAN_FREE_LIMITS=
PLAN_TEAM_LIMITS=
PLAN_BUSINESS_LIMITS=
# Куда писать за подпиской: URL, иначе mailto:PLAN_CONTACT_EMAIL
PLAN_CONTACT_URL=
PLAN_CONTACT_EMAIL=it@gptunnel.ai
# Баланс и суточные места (ADR-0080 v5). Все флаги выключены, пока rollout их не включит;
# в compose не прокинуты до этапа rollout. Ключи — только из secret store, не в репозитории.
# BILLING_ENABLED=false
# BILLING_STRIPE_ENABLED=false
# BILLING_DEBITS_ENABLED=false
# BILLING_ENFORCEMENT_ENABLED=false
# BILLING_AUTO_TOPUP_ENABLED=false
# BILLING_AUTO_TOPUP_REQUIRE_RECONCILE=   # после restore БД: новый уникальный маркер; автопополнение ждёт сверки (docs/06)
# BILLING_SELF_SERVE=false
# BILLING_PROVIDERS=stripe:global
# BILLING_PUBLIC_RETURN_URL=https://app.example.com/api/billing/return
# BILLING_TEST_CLOCK=false            # только dev/стенд; с live-ключами сервер не стартует
# STRIPE_SECRET_KEY=                   # sk_test_…; sk_live_ отклоняется без STRIPE_LIVEMODE_ALLOWED
# STRIPE_WEBHOOK_SECRET=               # whsec_… (через запятую при ротации; локально — из `stripe listen`)
# STRIPE_API_VERSION=
# STRIPE_LIVEMODE_ALLOWED=false
# Bot API (ADR-0031): лимиты на одного бота — запросов в секунду и сообщений в минуту
BOT_RATE_PER_SEC=30
BOT_MESSAGES_PER_MIN=20
# Запись встреч и транскрибация в GPTunneL (ADR-0025): адрес API устройств GPTunneL и сколько
# встреч сервер пишет одновременно (egress, ~0.5 CPU и ~60 МБ/ч на запись; файлы ≤ 7 дней).
GPTUNNEL_API_URL=https://gptunnel.ru
# Links GPTunneL gives on app.gptunnel.ai are shown on this host (docs/17).
GPTUNNEL_WEB_URL=https://gptunnel.ru
RECORDING_MAX_CONCURRENT=3
# A done recording's audio stays attached to its chat card this many days.
RECORDING_KEEP_DAYS=30
# Телефония (ADR-0046): 1 = поднять LiveKit SIP (compose-профиль sip) — исходящие звонки на номера
# из голосовых комнат. Аккаунт провайдера задаётся в приложении (Настройки пространства → Телефония),
# не здесь. Перед включением открыть в файрволе 5060/udp+tcp и 10000–10200/udp (docs/03 «SIP»).
SIP_ENABLED=0
# Суперадмины (через запятую): /api/admin/*
SUPERADMIN_EMAILS=it@unne.ai
# Offsite-копия бэкапов (rclone remote:path), пусто = только локально. TODO владелец.
OFFSITE_RCLONE_REMOTE=

# Optional compose.push.yml overlay. Key files are external and mounted read-only.
# Set PUSH_SECRET_DIRECTORY to an existing directory outside the checkout; api runs uid 65532.
# Use in-container paths (example: /run/calab-push/apns.p8), never the host path below.
# PUSH_SECRET_DIRECTORY=/operator-owned/path
# PUSH_APNS_KEY_FILE=/run/calab-push/apns.p8
# PUSH_APNS_KEY_ID=
# PUSH_APNS_TEAM_ID=
# PUSH_APNS_APP_ID=
# PUSH_APNS_ENVIRONMENT=development
# PUSH_VOIP_ENABLED=true
# PUSH_FCM_SERVICE_ACCOUNT_FILE=/run/calab-push/fcm.json
# PUSH_FCM_PROJECT_ID=
# PUSH_FCM_APP_ID=
